ildren: React.ReactNode;\n  style?: any;\n}\n\nexport default function PurpleGradientBg({ children, style }: PurpleGradientBgProps) {\n  return (\n    <LinearGradient\n      colors={['#667eea', '#764ba2']}\n      start={{ x: 0, y: 0 }}\n      end={{ x: 1, y: 1 }}\n      style={[styles.gradient, style]}\n    >\n      {children}\n    </LinearGradient>\n);\n}\n\nconst styles = StyleSheet.create({\n  gradient: {\n    flex: 1,\n  },\n});","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Mukul raj\\Downloads\\rez-new\\rez-app\\frontend\\components\\order\\OrderFilterModal.tsx","messages":[{"ruleId":"@typescript-eslint/array-type","severity":1,"message":"Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","line":32,"column":24,"nodeType":"TSTypeReference","messageId":"errorStringArray","endLine":32,"endColumn":76,"fix":{"range":[701,753],"text":"{ value: 'all' | OrderStatus; label: string }[]"}},{"ruleId":"@typescript-eslint/array-type","severity":1,"message":"Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","line":44,"column":27,"nodeType":"TSTypeReference","messageId":"errorStringArray","endLine":44,"endColumn":84,"fix":{"range":[1207,1264],"text":"{ value: OrderFilter['dateRange']; label: string }[]"}},{"ruleId":"@typescript-eslint/array-type","severity":1,"message":"Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","line":52,"column":22,"nodeType":"TSTypeReference","messageId":"errorStringArray","endLine":52,"endColumn":76,"fix":{"range":[1508,1562],"text":"{ value: OrderFilter['sortBy']; label: string }[]"}},{"ruleId":"@typescript-eslint/array-type","severity":1,"message":"Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","line":74,"column":14,"nodeType":"TSTypeReference","messageId":"errorStringArray","endLine":74,"endColumn":50,"fix":{"range":[2081,2117],"text":"{ value: any; label: string }[]"}},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":74,