rom '@/types/playPage.types';\nimport VideoCard from './VideoCard';\n\nconst { width } = Dimensions.get('window');\n\nexport default function VideoGrid({ \n  items, \n  onItemPress, \n  autoPlay = true,\n  showLoadMore = false,\n  onLoadMore,\n  loading = false \n}: VideoGridProps) {\n  \n  const renderVideoCard = ({ item }: { item: any }) => (\n    <VideoCard\n      item={item}\n      onPress={onItemPress}\n      autoPlay={autoPlay}\n      size=\"medium\"\n      style={styles.card}\n    />\n  );\n\n  const renderLoadMore = () => {\n    if (!showLoadMore) return null;\n\n    return (\n      <View style={styles.loadMoreContainer}>\n        {loading ? (\n          <ActivityIndicator size=\"large\" color={PLAY_PAGE_COLORS.primary} />\n        ) : (\n          <TouchableOpacity \n            style={styles.loadMoreButton}\n            onPress={onLoadMore}\n            activeOpacity={0.85}\n          >\n            <ThemedText style={styles.loadMoreText}>Load More</ThemedText>\n          </TouchableOpacity>\n        )}\n      </View>\n    );\n  };\n\n  const renderEmpty = () => (\n    <View style={styles.emptyContainer}>\n      <ThemedText style={styles.emptyText}>No Videos Yet 📭</ThemedText>\n      <ThemedText style={styles.emptySubtext}>\n        Check back soon for fresh content!\n      </ThemedText>\n    </View>\n  );\n\n  return (\n    <View style={styles.container}>\n      {items.length === 0 ? (\n        renderEmpty()\n      ) : (\n        <FlatList\n          data={items}\n          renderItem={renderVideoCard}\n          keyExtractor={(item, index) => `${item.id || index}`}\n          horizontal\n          showsHorizontalScrollIndicator={false}\n          contentContainerStyle={styles.horizontalList}\n          ItemSeparatorComponent={() => <View style={{ width: 16 }} />}\n          ListFooterComponent={renderLoadMore}\n          snapToInterval={width * 0.7 + 16}   // smooth snapping like carousel\n          decelerationRate=\"fast\"\n          snapToAlignment=\"start\"\n        />\n      )}\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n  },\n  horizontalList: {\n    paddingHorizontal: 20,\n    paddingBottom: 16,\n  },\n  card: {\n    width: width * 0.7, // make cards 70% of screen width\n    borderRadius: 16,\n    overflow: 'hidden',\n    shadowColor: '#000',\n    shadowOffset: { width: 0, height: 6 },\n    shadowOpacity: 0.15,\n    shadowRadius: 8,\n    elevation: 5,\n  },\n  loadMoreContainer: {\n    justifyContent: 'center',\n    alignItems: 'center',\n    paddingRight: 30,\n  },\n  loadMoreButton: {\n    backgroundColor: PLAY_PAGE_COLORS.primary,\n    borderRadius: 30,\n    paddingHorizontal: 30,\n    paddingVertical: 12,\n    shadowColor: PLAY_PAGE_COLORS.shadow,\n    shadowOffset: { width: 0, height: 4 },\n    shadowOpacity: 0.25,\n    shadowRadius: 6,\n    elevation: 5,\n  },\n  loadMoreText: {\n    color: '#FFF',\n    fontSize: 15,\n    fontWeight: '700',\n    letterSpacing: 0.3,\n  },\n  emptyContainer: {\n    paddingVertical: 60,\n    paddingHorizontal: 20,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  emptyText: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: PLAY_PAGE_COLORS.text,\n    marginBottom: 6,\n  },\n  emptySubtext: {\n    fontSize: 14,\n    color: PLAY_PAGE_COLORS.textSecondary,\n    textAlign: 'center',\n    opacity: 0.8,\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Mukul raj\\Downloads\\rez-new\\rez-app\\frontend\\components\\playPage\\VideoVisibilityManager.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Mukul raj\\Downloads\\rez-new\\rez-app\\frontend\\components\\play\\ChallengeCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\