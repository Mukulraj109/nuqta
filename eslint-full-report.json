  distance?: number;\n  distanceUnit?: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface OpeningHoursInfo {\n  outlet: {\n    _id: string;\n    name: string;\n  };\n  openingHours: {\n    day: string;\n    open: string;\n    close: string;\n    isClosed: boolean;\n  }[];\n  isOpenNow: boolean;\n  currentDay: string;\n  currentTime: string;\n}\n\nexport interface NearbyOutletsResponse {\n  outlets: Outlet[];\n  count: number;\n  searchCenter: {\n    lng: number;\n    lat: number;\n  };\n  searchRadius: number;\n}\n\nexport interface OutletOffersResponse {\n  outlet: {\n    _id: string;\n    name: string;\n    address: string;\n  };\n  offers: any[];\n  offersCount: number;\n}\n\nclass OutletsApi {\n  /**\n   * Get all outlets with filters\n   */\n  async getOutlets(params?: {\n    store?: string;\n    isActive?: boolean;\n    sortBy?: string;\n    order?: string;\n    page?: number;\n    limit?: number;\n  }): Promise<ApiResponse<{ outlets: Outlet[]; total: number }>> {\n    try {\n      const response = await apiClient.get<any>('/outlets', params);\n      return response;\n    } catch (error) {\n      console.error('[OUTLETS API] Error fetching outlets:', error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get single outlet by ID\n   */\n  async getOutletById(id: string): Promise<ApiResponse<Outlet>> {\n    try {\n      const response = await apiClient.get<Outlet>(`/outlets/${id}`);\n      return response;\n    } catch (error) {\n      console.error(`[OUTLETS API] Error fetching outlet ${id}:`, error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get outlets for a specific store\n   */\n  async getOutletsByStore(\n    storeId: string,\n    params?: {\n      isActive?: boolean;\n      page?: number;\n      limit?: number;\n    }\n  ): Promise<ApiResponse<{ outlets: Outlet[]; total: number }>> {\n    try {\n      const response = await apiClient.get<any>(`/outlets/store/${storeId}`, params);\n      return response;\n    } catch (error) {\n      console.error(`[OUTLETS API] Error fetching outlets for store ${storeId}:`, error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get outlet count for a store\n   */\n  async getStoreOutletCount(storeId: string): Promise<ApiResponse<{ storeId: string; outletCount: number }>> {\n    try {\n      const response = await apiClient.get<{ storeId: string; outletCount: number }>(\n        `/outlets/store/${storeId}/count`\n      );\n      return response;\n    } catch (error) {\n      console.error(`[OUTLETS API] Error fetching outlet count for store ${storeId}:`, error);\n      throw error;\n    }\n  }\n\n  /**\n   * Find nearby outlets based on location\n   */\n  async getNearbyOutlets(params: {\n    lng: number;\n    lat: number;\n    radius?: number;\n    limit?: number;\n    store?: string;\n  }): Promise<ApiResponse<NearbyOutletsResponse>> {\n    try {\n      const response = await apiClient.get<NearbyOutletsResponse>('/outlets/nearby', params);\n      return response;\n    } catch (error) {\n      console.error('[OUTLETS API] Error fetching nearby outlets:', error);\n      throw error;\n    }\n  }\n\n  /**\n   * Search outlets by name or address\n   */\n  async searchOutlets(data: {\n    query: string;\n    store?: string;\n    page?: number;\n    limit?: number;\n  }): Promise<ApiResponse<{ outlets: Outlet[]; total: number }>> {\n    try {\n      const response = await apiClient.post<any>('/outlets/search', data);\n      return response;\n    } catch (error) {\n      console.error('[OUTLETS API] Error searching outlets:', error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get opening hours for a specific outlet\n   */\n  async getOutletOpeningHours(id: string): Promise<ApiResponse<OpeningHoursInfo>> {\n    try {\n      const response = await apiClient.get<OpeningHoursInfo>(`/outlets/${id}/opening-hours`);\n      return response;\n    } catch (error) {\n      console.error(`[OUTLETS API] Error fetching opening hours for outlet ${id}:`, error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get offers available at a specific outlet\n   */\n  async getOutletOffers(id: string): Promise<ApiResponse<OutletOffersResponse>> {\n    try {\n      const response = await apiClient.get<OutletOffersResponse>(`/outlets/${id}/offers`);\n      return response;\n    } catch (error) {\n      console.error(`[OUTLETS API] Error fetching offers for outlet ${id}:`, error);\n      throw error;\n    }\n  }\n}\n\n// Create singleton instance\nconst outletsApi = new OutletsApi();\n\nexport default outletsApi;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Mukul raj\\Downloads\\rez-new\\rez-app\\frontend\\services\\partnerApi.ts","messages":[{"ruleId":"@typescript-eslint/array-type","severity":1,"message":"Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","line":106,"column":17,"nodeType":"TSTypeReference","messageId":"errorStringArray","endLine":113,"endColumn":5,"fix":{"range":[1962,2151],"text":"{\n    _id: string;\n    amount: number;\n    type: 'commission' | 'bonus' | 'referral';\n    status: 'pending' | 'approved' | 'paid';\n    description: string;\n    createdAt: string;\n  }[]"}},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":132,"column":22,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":132,"endColumn":25,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2530,2533],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2530,2533],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/array-type","severity":1,"message":"Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","line":133,"column":16,"nodeType":"TSTypeReference","messageId":"errorStringArray","endLine":138,"endCo