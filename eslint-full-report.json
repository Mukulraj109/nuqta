ackgroundColor: '#FFFFFF',\n    borderBottomLeftRadius: 24,\n    borderBottomRightRadius: 24,\n    marginHorizontal: 16,\n  },\n  searchHintTitle: {\n    fontSize: 18,\n    fontWeight: '600',\n    color: '#6B7280',\n    marginTop: 16,\n    marginBottom: 8,\n  },\n  searchHintText: {\n    fontSize: 14,\n    color: '#9CA3AF',\n    textAlign: 'center',\n    lineHeight: 20,\n  },\n});","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Mukul raj\\Downloads\\rez-new\\rez-app\\frontend\\app\\home-delivery\\section\\[sectionId].tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is assigned a value but never used.","line":40,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":40,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'setSortBy' is assigned a value but never used.","line":49,"column":18,"nodeType":null,"messageId":"unusedVar","endLine":49,"endColumn":27},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadSectionProducts'. Either include it or remove the dependency array.","line":55,"column":6,"nodeType":"ArrayExpression","endLine":55,"endColumn":17,"suggestions":[{"desc":"Update the dependencies array to be: [loadSectionProducts, sectionId]","fix":{"range":[1792,1803],"text":"[loadSectionProducts, sectionId]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'applyFiltersAndSort'. Either include it or remove the dependency array.","line":59,"column":6,"nodeType":"ArrayExpression","endLine":59,"endColumn":33,"suggestions":[{"desc":"Update the dependencies array to be: [products, filters, sortBy, applyFiltersAndSort]","fix":{"range":[1859,1886],"text":"[products, filters, sortBy, applyFiltersAndSort]"}}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":79,"column":58,"nodeType":